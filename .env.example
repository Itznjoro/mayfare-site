# Copy this file to .env for local development (drizzle-kit reads it).
# In production, this is already set in your Vercel project's Environment
# Variables automatically (created when you connected Prisma Postgres) —
# never commit real credentials here.

# From your Prisma Postgres dashboard: "Show secret" next to DATABASE_URL
DATABASE_URL="postgresql://hostname:password@db.prisma.io:5432/postgres?sslmode=require"
